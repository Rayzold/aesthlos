# Cloudflare Pages / Netlify response headers (ignored by other hosts).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Build output with hashed file names never changes: cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images, videos and PDFs keep their names when replaced, so cache for a week only.
/images/*
  Cache-Control: public, max-age=604800
/video/*
  Cache-Control: public, max-age=604800
/files/*
  Cache-Control: public, max-age=604800
