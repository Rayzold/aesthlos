# Cloudflare Pages / Netlify response headers (ignored by other hosts).
# HSTS: HTTPS only for a year. No includeSubDomains: webmail.aesthlos.com is on papaki's server.
# CSP: only our own files; the contact form posts to Jotform (EU). 'unsafe-inline' is required by the
# static Next.js export (inline bootstrap scripts) and inline styles. Cloudflare Web Analytics allowed.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self'; connect-src 'self' https://eu-submit.jotform.com https://cloudflareinsights.com; form-action 'self' https://eu-submit.jotform.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Build output with hashed file names never changes: cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images, videos and PDFs keep their names when replaced, so cache for a week only.
/images/*
  Cache-Control: public, max-age=604800
/video/*
  Cache-Control: public, max-age=604800
/files/*
  Cache-Control: public, max-age=604800
