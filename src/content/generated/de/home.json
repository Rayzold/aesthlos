    {
     "text": "Die fünf Botanische Kompositionen",
     "color": "#FFC824"
    }
   ]
  },
  {
   "type": "gallery",
   "section": "comp-llnr20ap",
   "id": "comp-m48hc4x0",
   "items": [
    {
